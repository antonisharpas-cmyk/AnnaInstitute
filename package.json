{
  "name": "oneeleven-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:render": "node scripts/render-start.mjs && NODE_OPTIONS='--max-old-space-size=256 --max-semi-space-size=8' next start",
    "lint": "eslint",
    "test": "tsx --test \"src/lib/**/*.test.ts\"",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push --force",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:migrate:ci": "tsx scripts/migrate.ts",
    "db:seed:ci": "tsx scripts/seed.ts",
    "db:fix": "node --env-file=.env.local --import tsx scripts/fix-db.ts",
    "db:check": "node --env-file=.env.local --import tsx scripts/check-db.ts",
    "db:check:ci": "tsx scripts/check-db.ts",
    "db:demo": "node --env-file=.env.local --import tsx scripts/demo.ts",
    "db:partners": "node --env-file=.env.local --import tsx scripts/partners.ts",
    "db:statuses": "node --env-file=.env.local --import tsx scripts/statuses.ts",
    "db:magnum": "node --env-file=.env.local --import tsx scripts/magnum.ts",
    "db:import1": "node --env-file=.env.local --import tsx scripts/import1.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.10.0",
    "next": "15.5.4",
    "nodemailer": "^10.0.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.6"
  }
}
