# Copy this file to .env.local and fill it in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Where the data lives
# ---------------------------------------------------------------------------

# Working locally. This is a real Postgres that lives in a folder inside the
# project, with nothing to install and no server to start. Keep it while we build.
DATABASE_URL="pglite://./.localdb"

# On Render, comment the line above and use the database URL instead. Nothing
# else in the application changes: same schema, same migrations, same SQL.
# DATABASE_URL="postgresql://user:password@dpg-xxxx-a.frankfurt-postgres.render.com:5432/oneeleven"

# One thing to know about the local database: only one process can open it at a
# time. Stop npm run dev before running db:migrate, db:seed or db:check.

# Secret used to sign the login cookie and the unsubscribe links.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change_me"

# The address the application is reached at. It is used to build the links
# inside messages, so it must be the real address in production.
APP_URL="http://localhost:3000"

# The first administrator, created by: npm run db:seed
SEED_ADMIN_EMAIL="info@ergonsite.com"
SEED_ADMIN_NAME="ErgonSite"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Uploaded files
# ---------------------------------------------------------------------------

# Where uploaded documents are written. On Render this MUST be a path on a
# mounted disk, otherwise every deploy throws the files away. render.yaml
# mounts a disk at /var/data for exactly this.
STORAGE_DIR="./storage"

# ---------------------------------------------------------------------------
# Email. Leave it unset and campaigns record every message as simulated
# instead of sending, which is how you rehearse before the account exists.
# ---------------------------------------------------------------------------

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="One Eleven <info@ergonsite.com>"
# Until SPF and DKIM exist on oneeleven.com.cy, send from a domain we control
# and put their address here so replies reach them.
MAIL_REPLY_TO="info@oneeleven-ent.cy"

# ---------------------------------------------------------------------------
# SMS, WhatsApp and Viber through SMS.to. Same rule: unset means simulated.
# ---------------------------------------------------------------------------

SMSTO_API_KEY=""
SMSTO_SENDER_ID="OneEleven"
SMSTO_BASE_URL="https://api.sms.to"

# WhatsApp and Viber are only attempted when a path is set here. Confirm the
# exact paths with SMS.to when the account is opened. WhatsApp additionally
# needs a dedicated number, business verification with Meta and approved
# message templates.
SMSTO_WHATSAPP_PATH=""
SMSTO_VIBER_PATH=""

# When WhatsApp or Viber is not available, send by SMS instead.
MESSAGING_FALLBACK_TO_SMS="true"

# Shared secret for the inbound webhook. Point the SMS.to inbound webhook at:
#   POST {APP_URL}/api/webhooks/sms-inbound?secret={this value}
# This is what makes "reply STOP" actually work.
SMSTO_CALLBACK_SECRET=""

# Leads from the website
#
# There is nothing to set here. The website posts to {APP_URL}/api/leads with a
# key in an X-Api-Key header, and that key is made inside the CRM, under Leads,
# API access. Only a hash of it is stored, so it cannot be read back out of the
# database or out of this file.
